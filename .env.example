# ═══════════════════════════════════════════════════════════════════════════
# ASES Environment Configuration
# Multi-Container Production Setup
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# REQUIRED: API Keys
# ───────────────────────────────────────────────────────────────────────────

# OpenAI (Required)
OPENAI_API_KEY=sk-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

# GitHub (Required for code storage)
GITHUB_TOKEN=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

# ───────────────────────────────────────────────────────────────────────────
# OPTIONAL: External Services
# ───────────────────────────────────────────────────────────────────────────

# Vercel (Optional - for deployments)
VERCEL_TOKEN=your-vercel-token

# Telegram (Optional - for notifications)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id

# Upwork (Optional - for lead discovery)
UPWORK_RSS_URL=https://www.upwork.com/ab/feed/topics/rss?securityToken=...&userUid=...&orgUid=...

# ───────────────────────────────────────────────────────────────────────────
# DATABASE
# ───────────────────────────────────────────────────────────────────────────

POSTGRES_USER=ases
POSTGRES_PASSWORD=ases_secure_random_password_$(openssl rand -hex 16)
POSTGRES_DB=ases_production

# Redis
REDIS_PASSWORD=ases_redis_random_password_$(openssl rand -hex 16)

# ───────────────────────────────────────────────────────────────────────────
# n8n
# ───────────────────────────────────────────────────────────────────────────

DOMAIN=ases.yourdomain.com
N8N_HOST=ases.yourdomain.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ases_admin_random_password_$(openssl rand -hex 16)
N8N_ENCRYPTION_KEY=ases_encryption_random_key_$(openssl rand -hex 32)

# ───────────────────────────────────────────────────────────────────────────
# ASES
# ───────────────────────────────────────────────────────────────────────────

TENANT_ID=default
LOG_LEVEL=INFO

# ── v2 additions ───────────────────────────────────────────
# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5678

# Worker concurrency (docker-compose --scale worker=N)
# No env var needed — set at deploy time

# ── v2.1 additions ─────────────────────────────────────────

# Max simultaneous Docker sandboxes across all workers.
# Rule of thumb: (host_RAM_gb * 1000) / 512
# Example: 8GB host → 16 max sandboxes
MAX_CONCURRENT_SANDBOXES=10

# Admin secret for the /admin/tenants/{slug}/rotate-key endpoint.
# Generate with: openssl rand -hex 32
# Keep this out of source control.
ADMIN_SECRET=replace_with_openssl_rand_hex_32

# ── v2.2 additions ─────────────────────────────────────────

# Per-tenant rate limiting (sliding 60s window)
# RATE_LIMIT_RPM: sustained requests per minute per tenant
# RATE_LIMIT_BURST: additional burst allowance on top of RPM
RATE_LIMIT_RPM=20
RATE_LIMIT_BURST=5

# ── v2.5 additions ─────────────────────────────────────────

# Telegram Bot Token (required for HITL inline keyboard callbacks)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# Cold outreach sender address
OUTREACH_FROM_EMAIL=you@yourdomain.com

# SendGrid API key (for cold outreach and CRM welcome emails)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Redis cache TTL overrides (optional — defaults in redis_cache.py are sensible)
# REDIS_CACHE_TTL_PLANNER=86400
# REDIS_CACHE_TTL_REVIEWER=43200
# REDIS_CACHE_TTL_CODER=3600
