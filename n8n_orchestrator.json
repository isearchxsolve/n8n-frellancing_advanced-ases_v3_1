      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },
    {
      "id": "split-cold-leads",
      "name": "🔄 Split Cold Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [650, 1100],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "ai-personalize-email",
      "name": "🤖 AI Personalize Cold Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 1100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_SERVICE_URL }}/personalize-email",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ lead_id: $json.id, name: $json.name, company: $json.company, notes: $json.notes, tenant_id: $env.TENANT_ID }) }}"
      }
    },
    {
      "id": "send-cold-email",
      "name": "📧 Send via SendGrid",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [1050, 1100],
      "parameters": {
        "operation": "send",
        "toEmail": "={{ $json.email }}",
        "fromEmail": "={{ $env.OUTREACH_FROM_EMAIL }}",
        "subject": "={{ $json.subject }}",
        "contentType": "plaintext",
        "content": "={{ $json.body }}"
      },
      "credentials": {
        "sendGridApi": { "id": "sendgrid-api", "name": "SendGrid API" }
      }
    },
    {
      "id": "log-outreach-db",
      "name": "📝 Log Outreach to DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1250, 1100],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE cold_leads SET outreach_status = 'contacted', last_contacted_at = NOW() WHERE id = {{ $json.lead_id }} AND tenant_id = '{{ $env.TENANT_ID }}';"
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },

    {
      "id": "crm-webhook",
      "name": "📥 CRM Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 1400],
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-update",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "crm-route",
      "name": "🔀 Route CRM Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [450, 1400],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": { "conditions": [{ "id": "new-client", "leftValue": "={{ $json.action }}", "rightValue": "new_client", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" },
              "renameOutput": true,
              "outputKey": "new_client"
            },
            {
              "conditions": { "conditions": [{ "id": "update-status", "leftValue": "={{ $json.action }}", "rightValue": "update_status", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" },
              "renameOutput": true,
              "outputKey": "update_status"
            },
            {
              "conditions": { "conditions": [{ "id": "add-note", "leftValue": "={{ $json.action }}", "rightValue": "add_note", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" },
              "renameOutput": true,
              "outputKey": "add_note"
            },
            {
              "conditions": { "conditions": [{ "id": "invoice-paid", "leftValue": "={{ $json.action }}", "rightValue": "invoice_paid", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" },
              "renameOutput": true,
              "outputKey": "invoice_paid"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "crm-add-client",
      "name": "📝 Add New Client to DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [700, 1280],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO clients (tenant_id, name, email, company, status, created_at) VALUES ('{{ $env.TENANT_ID }}', '{{ $json.name }}', '{{ $json.email }}', '{{ $json.company }}', 'active', NOW()) ON CONFLICT (tenant_id, email) DO NOTHING RETURNING id;"
      },
      "credentials": { "postgres": { "id": "postgres-db", "name": "PostgreSQL" } }
    },
    {
      "id": "crm-welcome-email",
      "name": "🎉 Welcome Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "position": [900, 1280],
      "parameters": {
        "operation": "send",
        "toEmail": "={{ $json.email }}",
        "fromEmail": "={{ $env.OUTREACH_FROM_EMAIL }}",
        "subject": "Welcome aboard, {{ $json.name }}!",
        "contentType": "plaintext",
        "content": "Hi {{ $json.name }},\n\nExcited to work with you! I'll be in touch shortly to kick things off.\n\nBest,"
      },
      "credentials": { "sendGridApi": { "id": "sendgrid-api", "name": "SendGrid API" } }
    },
    {
      "id": "crm-update-status",
      "name": "🔄 Update Client Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [700, 1400],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE clients SET status = '{{ $json.status }}', updated_at = NOW() WHERE tenant_id = '{{ $env.TENANT_ID }}' AND email = '{{ $json.email }}';"
      },
      "credentials": { "postgres": { "id": "postgres-db", "name": "PostgreSQL" } }
    },
    {
      "id": "crm-status-notify",
      "name": "📊 Status Change Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [900, 1400],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "📊 Client *{{ $json.email }}* status → `{{ $json.status }}`",
        "additionalOptions": { "parse_mode": "Markdown" }
      },
      "credentials": { "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" } }
    },
    {
      "id": "crm-add-note",
      "name": "📝 Append Note to Client",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [700, 1520],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO client_notes (tenant_id, client_email, note, created_at) VALUES ('{{ $env.TENANT_ID }}', '{{ $json.email }}', '{{ $json.note }}', NOW());"
      },
      "credentials": { "postgres": { "id": "postgres-db", "name": "PostgreSQL" } }
    },
    {
      "id": "crm-log-payment",
      "name": "💰 Log Payment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [700, 1640],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO payments (tenant_id, client_email, amount_usd, invoice_id, paid_at) VALUES ('{{ $env.TENANT_ID }}', '{{ $json.email }}', {{ $json.amount }}, '{{ $json.invoice_id }}', NOW());"
      },
      "credentials": { "postgres": { "id": "postgres-db", "name": "PostgreSQL" } }
    },
    {
      "id": "crm-payment-notify",
      "name": "💸 Payment Celebration",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [900, 1640],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "💸 Payment received: *${{ $json.amount }}* from {{ $json.email }} 🎉",
        "additionalOptions": { "parse_mode": "Markdown" }
      },
      "credentials": { "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" } }
    },

    {
      "id": "dev-webhook",
      "name": "🛠️ Dev Task Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 1800],
      "parameters": {
        "httpMethod": "POST",
        "path": "dev-task",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "call-dev-agent",
      "name": "🤖 Call Dev Agent Service",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 1800],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_SERVICE_URL }}/dev-task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 300000
        }
      }
    },
    {
      "id": "dev-response",
