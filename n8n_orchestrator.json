{
  "name": "ASES Orchestrator v2.5",
  "nodes": [
    {
      "id": "trigger-schedule",
      "name": "📅 Schedule Trigger (30min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      }
    },
    {
      "id": "fetch-rss",
      "name": "🌐 Fetch Job RSS Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.UPWORK_RSS_URL }}",
        "options": {}
      }
    },
    {
      "id": "parse-rss",
      "name": "🔧 Parse RSS → JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const xml = $input.first().json.data;\nconst items = [];\nconst itemRegex = /<item>[\\s\\S]*?<\\/item>/g;\nlet itemMatch;\nwhile ((itemMatch = itemRegex.exec(xml)) !== null) {\n  const item = itemMatch[0];\n  const titleMatch = item.match(/<title>(.*?)<\\/title>/);\n  const linkMatch = item.match(/<link>(.*?)<\\/link>/);\n  const descMatch = item.match(/<description>(.*?)<\\/description>/);\n  const dateMatch = item.match(/<pubDate>(.*?)<\\/pubDate>/);\n  const title = titleMatch ? titleMatch[1].replace(/<![CDATA[(.*?)]]]>/g, '$1').trim() : 'No Title';\n  const link = linkMatch ? linkMatch[1].trim() : '';\n  let desc = descMatch ? descMatch[1].replace(/<![CDATA[(.*?)]]]>/g, '$1') : '';\n  desc = desc.replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  const pubDate = dateMatch ? dateMatch[1].trim() : '';\n  let jobId = link;\n  try {\n    const url = new URL(link);\n    jobId = url.searchParams.get('~') || url.pathname.split('/').pop() || link;\n  } catch(e) {\n    jobId = link.split('/').pop().split('?')[0] || link;\n  }\n  items.push({\n    json: {\n      jobId,\n      title,\n      description: desc.substring(0, 1200),\n      link,\n      pubDate,\n      rawDate: new Date().toISOString()\n    }\n  });\n}\nreturn items;"
      }
    },
    {
      "id": "split-batches",
      "name": "🔄 Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [850, 300],
      "parameters": { "batchSize": 1, "options": {} }
    },
    {
      "id": "call-agent-service",
      "name": "🤖 Call Agent Service (Score + Proposal)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1050, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENT_SERVICE_URL }}/process-job",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  job_id: $json.jobId,\n  title: $json.title,\n  description: $json.description,\n  link: $json.link,\n  pub_date: $json.pubDate,\n  tenant_id: $env.TENANT_ID || 'default'\n}) }}",
        "options": {}
      }
    },
    {
      "id": "check-bid",
      "name": "❓ Should Bid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1250, 300],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "should-bid",
              "leftValue": "={{ $json.should_bid }}",
              "rightValue": "true",
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "send-hitl-prompt",
      "name": "📱 Send HITL Approval Prompt",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1450, 200],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "🚀 *New Lead — Score {{ $json.score }}/10*\n\n*Title:* {{ $json.title }}\n*Link:* {{ $json.link }}\n*Why:* {{ $json.reason }}\n\n*Proposal:*\n{{ $json.proposal }}\n\n⬇️ Approve or reject below.",
        "additionalOptions": {
          "parse_mode": "Markdown",
          "reply_markup": {
            "inline_keyboard": [
              [
                {
                  "text": "✅ APPROVE & BID",
                  "callback_data": "={{ 'approve:' + $json.job_id }}"
                },
                {
                  "text": "❌ REJECT",
                  "callback_data": "={{ 'reject:' + $json.job_id }}"
                }
              ]
            ]
          }
        }
      },
      "credentials": {
        "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" }
      }
    },
    {
      "id": "log-to-db-pending",
      "name": "📝 Log Lead to PostgreSQL (pending)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1650, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jobs (tenant_id, job_id, title, description, link, score, reason, proposal, status, created_at)\nVALUES ('{{ $env.TENANT_ID }}', '{{ $json.job_id }}', $1, $2, '{{ $json.link }}', {{ $json.score }}, $3, $4, 'pending_approval', NOW())\nON CONFLICT (tenant_id, job_id) DO NOTHING;",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },
    {
      "id": "log-to-db-skipped",
      "name": "📝 Log Lead to PostgreSQL (skipped)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1450, 400],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO jobs (tenant_id, job_id, title, description, link, score, reason, proposal, status, created_at)\nVALUES ('{{ $env.TENANT_ID }}', '{{ $json.job_id }}', $1, $2, '{{ $json.link }}', {{ $json.score }}, $3, '', 'skipped_low_score', NOW())\nON CONFLICT (tenant_id, job_id) DO NOTHING;",
        "additionalFields": {}
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },

    {
      "id": "telegram-callback",
      "name": "📨 Telegram Callback Query Listener",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [250, 700],
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" }
      }
    },
    {
      "id": "parse-callback",
      "name": "🔍 Parse Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 700],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cb = $input.first().json.callback_query;\nconst data = cb?.data || '';\nconst chatId = cb?.message?.chat?.id;\nconst messageId = cb?.message?.message_id;\nconst callbackQueryId = cb?.id;\nconst parts = data.split(':');\nconst action = parts[0];\nconst jobId = parts[1];\nconst isApprove = action === 'approve';\nreturn [{ json: { action, jobId, chatId, messageId, callbackQueryId, isApprove } }];"
      }
    },
    {
      "id": "answer-callback",
      "name": "✅ Answer Callback (dismiss spinner)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 700],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback_query_id: $json.callbackQueryId, text: $json.isApprove ? '✅ Approved! Submitting...' : '❌ Rejected.' }) }}"
      }
    },
    {
      "id": "route-approval",
      "name": "❓ Is Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 700],
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "id": "is-approve",
              "leftValue": "={{ $json.isApprove }}",
              "rightValue": "true",
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "load-job-from-db",
      "name": "🗄️ Load Job Proposal from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1050, 620],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT job_id, title, link, proposal FROM jobs WHERE tenant_id = '{{ $env.TENANT_ID }}' AND job_id = '{{ $json.jobId }}' LIMIT 1;"
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },
    {
      "id": "puppeteer-submit",
      "name": "🤖 Puppeteer: Submit Proposal",
      "type": "n8n-nodes-puppeteer.customScript",
      "typeVersion": 1,
      "position": [1250, 620],
      "parameters": {
        "code": "const { page, browser } = $puppeteer;\nconst job = $input.first().json;\nawait page.goto(job.link, { waitUntil: 'networkidle2', timeout: 30000 });\n// --- Upwork login check ---\nconst isLoggedIn = await page.$('.nav-logged-in') !== null;\nif (!isLoggedIn) {\n  await page.goto('https://www.upwork.com/ab/account-security/login');\n  await page.type('#login_username', process.env.UPWORK_EMAIL, { delay: 50 });\n  await page.click('#login_password_continue');\n  await page.waitForSelector('#login_password', { timeout: 8000 });\n  await page.type('#login_password', process.env.UPWORK_PASSWORD, { delay: 50 });\n  await page.click('#login_control_continue');\n  await page.waitForNavigation({ timeout: 15000 });\n}\n// --- Fill proposal ---\nawait page.waitForSelector('[data-cy=cover-letter-text]', { timeout: 10000 });\nawait page.click('[data-cy=cover-letter-text]');\nawait page.keyboard.down('Control');\nawait page.keyboard.press('A');\nawait page.keyboard.up('Control');\nawait page.type('[data-cy=cover-letter-text]', job.proposal, { delay: 20 });\n// --- Screenshot before submit ---\nconst screenshot = await page.screenshot({ encoding: 'base64', type: 'jpeg', quality: 80 });\nreturn [{ json: { jobId: job.job_id, jobLink: job.link, screenshot, submitted: false, pendingConfirm: true } }];",
        "options": {}
      }
    },
    {
      "id": "screenshot-to-telegram",
      "name": "📸 Screenshot → Telegram (final confirm)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1450, 620],
      "parameters": {
        "resource": "message",
        "operation": "sendPhoto",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "binaryData": false,
        "photoUrl": "=data:image/jpeg;base64,{{ $json.screenshot }}",
        "additionalOptions": {
          "caption": "📋 Proposal filled for {{ $json.jobLink }}.\n\nReply CONFIRM to actually click Submit, or ABORT to leave.",
          "parse_mode": "Markdown"
        }
      },
      "credentials": {
        "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" }
      }
    },
    {
      "id": "update-status-approved",
      "name": "📝 Update Job Status → approved",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1650, 620],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs SET status = 'approved_pending_submit', updated_at = NOW() WHERE tenant_id = '{{ $env.TENANT_ID }}' AND job_id = '{{ $json.jobId }}';"
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },
    {
      "id": "notify-rejected",
      "name": "📱 Notify: Rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1050, 820],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "❌ Job {{ $json.jobId }} rejected. Skipping.",
        "additionalOptions": {}
      },
      "credentials": {
        "telegramApi": { "id": "telegram-bot-api", "name": "Telegram Bot API" }
      }
    },
    {
      "id": "update-status-rejected",
      "name": "📝 Update Job Status → rejected",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [1250, 820],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE jobs SET status = 'rejected', updated_at = NOW() WHERE tenant_id = '{{ $env.TENANT_ID }}' AND job_id = '{{ $json.jobId }}';"
      },
      "credentials": {
        "postgres": { "id": "postgres-db", "name": "PostgreSQL" }
      }
    },

    {
      "id": "cold-outreach-trigger",
      "name": "📅 Weekly Cold Outreach Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 1100],
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1 }]
        }
      }
    },
    {
